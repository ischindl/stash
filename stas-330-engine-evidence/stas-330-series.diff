+/*
+FNXC:WakeCommentConsumption 2026-10-16 (STAS-330) — written against trunk and observed FAILING first.
+
+Three agent-facing surfaces read a card's `steeringComments` and treat every row as somebody else's
+input. On trunk none of them looks at the author:
+
+- `workflowInputRepliesAfterWatermark` (`executor/workflow-input-markers.ts`) answers "has the user
+  replied?" for a paused workflow node.
+- `runAwaitInputNode` (`executor/await-input-node.ts`) re-implements the same watermark filter inline
+  and resumes the graph on whatever it finds.
+- `buildSteeringCommentsSection` (`executor/execution-prompt.ts`) renders the last ten rows under a
+  heading that claims they "were added by the user during execution".
+
+A row the executing agent authored itself therefore reads as fresh user instruction on all three: the
+reply detector satisfies itself, the graph resumes on the agent's own words, and the prompt re-presents
+them as new guidance. `await-input-node.ts` also duplicated the watermark parser instead of calling the
+marker helper, so a fix applied to one detector would not reach the other — the second reason this
+harness exists.
+
+Fixture honesty: `SteeringComment.author` is the two-value literal `"user" | "agent"` and no writer puts an
+agent identity on a steering row today, so the `agent-ff03cfcc` casts below describe a state the declared
+type forbids. They pin the seam for the writer-side identity stamp, not shipped steering behaviour; the
+production shape where the predicate is load-bearing is a free-string `TaskComment.author`, which
+`wake-comment-delta-consumption.test.ts` covers without a cast.
+*/
+import { describe, it, expect, vi } from "vitest";
+import type { SteeringComment, TaskDetail, WorkflowIrNode } from "@fusion/core";
+import { workflowInputRepliesAfterWatermark } from "../executor/workflow-input-markers.js";
+import { runAwaitInputNode } from "../executor/await-input-node.js";
+import { buildSteeringCommentsSection } from "../executor/execution-prompt.js";
+
+const PAUSE_MS = Date.parse("2026-10-03T00:00:00.000Z");
+
+function steering(id: string, author: SteeringComment["author"], minutesAfterPause: number): SteeringComment {
+  return {
+    id,
+    author,
+    text: `body of ${id}`,
+    createdAt: new Date(PAUSE_MS + minutesAfterPause * 60_000).toISOString(),
+  };
+}
+
+function pausedCard(overrides: Partial<TaskDetail> = {}): TaskDetail {
+  return {
+    id: "STAS-330",
+    title: "Wake comment delta consumption",
+    description: "d",
+    status: null,
+    column: "building",
+    assignedAgentId: "agent-ff03cfcc",
+    paused: false,
+    pausedReason: `workflow-input:ask-user-1@${PAUSE_MS}: Which lane?`,
+    steeringComments: [],
+    ...overrides,
+  } as unknown as TaskDetail;
+}
+
+describe("workflow-input reply detector ignores the executing agent's own steering", () => {
+  it("still counts an operator reply after the watermark", () => {
+    const task = pausedCard({ steeringComments: [steering("c-user", "user", 5)] });
+
+    expect(workflowInputRepliesAfterWatermark(task, "workflow-input:ask-user-1")).toHaveLength(1);
+  });
+
+  it("does not count a row the card's own assignee authored", () => {
+    const task = pausedCard({ steeringComments: [steering("c-self", "agent", 5, )] });
+    // The authoring agent is the card's assignee, which is the only identity the executor lane holds.
+    (task as { assignedAgentId?: string }).assignedAgentId = "agent-ff03cfcc";
+    (task.steeringComments![0] as { author: string }).author = "agent-ff03cfcc";
+
+    expect(workflowInputRepliesAfterWatermark(task, "workflow-input:ask-user-1")).toEqual([]);
+  });
+
+  it("keeps pre-watermark rows out of the answer either way", () => {
+    const task = pausedCard({ steeringComments: [steering("c-old", "user", -10)] });
+
+    expect(workflowInputRepliesAfterWatermark(task, "workflow-input:ask-user-1")).toEqual([]);
+  });
+});
+
+describe("await-input node does not resume on its own agent's steering", () => {
+  const node = { id: "ask-user-1", kind: "ask-user", config: { question: "Which lane?" } } as WorkflowIrNode;
+
+  function deps() {
+    return {
+      store: {
+        updateTask: vi.fn().mockResolvedValue(undefined),
+        logEntry: vi.fn().mockResolvedValue(undefined),
+      },
+      getRunContextFor: () => undefined,
+    };
+  }
+
+  it("resumes when a real reply arrived", async () => {
+    const d = deps();
+    const task = pausedCard({ steeringComments: [steering("c-user", "user", 5)] });
+
+    const result = await runAwaitInputNode(d as never, node, task);
+
+    expect(result.outcome).toBe("success");
+    expect(result.value).toBe("input-received");
+  });
+
+  it("re-parks when the only post-watermark row was authored by the agent itself", async () => {
+    const d = deps();
+    const selfAuthored = steering("c-self", "user", 5);
+    (selfAuthored as unknown as { author: string }).author = "agent-ff03cfcc";
+    const task = pausedCard({ steeringComments: [selfAuthored] });
+
+    const result = await runAwaitInputNode(d as never, node, task);
+
+    expect(result).toEqual({ outcome: "failure", value: "awaiting-user-input" });
+    expect(d.store.updateTask).toHaveBeenCalledWith(
+      "STAS-330",
+      expect.objectContaining({ status: "awaiting-user-input", paused: true }),
+      undefined,
+    );
+  });
+});
+
+describe("executor steering section does not echo the executing agent's own rows", () => {
+  it("renders operator steering", () => {
+    const task = pausedCard({ steeringComments: [steering("c-user", "user", 5)] });
+
+    const section = buildSteeringCommentsSection(task);
+
+    expect(section).toContain("## Steering Comments");
+    expect(section).toContain("body of c-user");
+  });
+
+  it("omits rows the executing agent authored while keeping everyone else's", () => {
+    const selfRow = steering("c-self", "user", 6);
+    (selfRow as unknown as { author: string }).author = "agent-ff03cfcc";
+    const task = pausedCard({ steeringComments: [steering("c-user", "user", 5), selfRow] });
+
+    const section = buildSteeringCommentsSection(task);
+
+    expect(section).toContain("body of c-user");
+    expect(section).not.toContain("body of c-self");
+  });
+
+  it("emits no section when every steering row is the agent's own", () => {
+    const selfRow = steering("c-self", "user", 6);
+    (selfRow as unknown as { author: string }).author = "agent-ff03cfcc";
+    const task = pausedCard({ steeringComments: [selfRow] });
+
+    expect(buildSteeringCommentsSection(task)).toBe("");
+  });
+});
