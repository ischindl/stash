+/*
+FNXC:WakeCommentConsumption 2026-10-16 (STAS-330):
+
+The comment half of a wake used to be a pure recomputation. Every wake re-derived "which steering
+comments are newer than my last run" from the card, and nothing anywhere recorded which ids the
+previous wake had already put in front of this agent. So an id could be advertised forever: STAS-270
+carried `b3102332`, `46128b1a`, `69516485` and `75217182` through 15+ re-wakes in two hours, the agent
+resolved none of them, and each wake re-raised the same unanswerable question.
+
+New content on a wake has to be a *consumption*, not a *recomputation*. The record of an advertisement
+already exists and is durable — the heartbeat run row's own `contextSnapshot.triggeringCommentIds`,
+written by `agent-heartbeat.ts` when the run opens, before the session starts. This module reads that
+record back and subtracts it, so:
+- an id survives only until the first wake that opens a run for this agent and card, whatever that run
+  then does or fails to do — consumption is recorded at run open, not at render time;
+- the accepted cost of recording that early: a wake that opens a run and then exits gracefully before
+  building a prompt (missing card, terminal card, checkout held by another agent) consumes its ids
+  without ever presenting them, and because the candidate window is `createdAt > lastRun.startedAt`,
+  that aborted run also closes the window over those ids. The row is not lost from execution — the
+  executor's `## Steering Comments` section still delivers it. Recording at render time instead would
+  hand the storm back every time a session dies mid-prompt, which is the bug this module exists to close;
+- a crashed or terminated run cannot un-consume what it was already told;
+- a deferred wake that replays the ids captured at schedule time (the `drainPendingAssignment`
+  re-fire) loses them at the same seam, because the subtraction happens at the wake's fire time
+  against durable state rather than against the value the trigger carried.
+
+Two deliberate limits, both stated as constants because an unbounded remembered set is the same
+"grows forever" defect in a different place:
+- `WAKE_COMMENT_CONSUMPTION_SCAN_RUNS` caps how far back the consumption window looks;
+- `MAX_CONSUMED_WAKE_COMMENT_IDS` caps the remembered set itself, newest-first.
+
+Self-echo is the second half of the file. A comment whose author string names the agent being woken
+is that agent's own words coming back at it as "new content", and the three agent-facing surfaces that
+read steering comments — the heartbeat delta, the executor's `## Steering Comments` section, and the
+workflow-input / await-input reply detectors — all treated it as external input. The predicate below
+is the one rule all three share.
+
+Decision — an unknown author is EXTERNAL input, never suppressed. `SteeringComment.author` is the
+two-value literal `"user" | "agent"` and every engine-side writer (`project-engine.ts`
+planner-oversight `injectGuidance` / `requestTargetedFix` / `requestConfirmation`,
+`overseer/overseer-advisor-service.ts`) writes `"agent"` without naming an authoring agent, because
+`addSteeringCommentImpl` carries no agent identity onto the row. Roughly 98% of the steering volume on
+the deployed board is that lifecycle guidance, and it is addressed TO the executing agent — filtering
+on `author === "agent"` would silence real instruction, which is a worse failure than one more echo.
+So suppression requires a positive match against an identity we actually hold; absence of evidence
+leans toward delivering the input.
+*/
+import type { AgentHeartbeatRun } from "@fusion/core";
+
+/** How many recent runs of this agent are consulted for already-advertised comment ids. */
+export const WAKE_COMMENT_CONSUMPTION_SCAN_RUNS = 20;
+
+/** Upper bound on comment ids remembered as advertised. The newest ids win; the oldest fall out. */
+export const MAX_CONSUMED_WAKE_COMMENT_IDS = 200;
+
+/*
+The heading the delta block is introduced by. It is exported because `agents/heartbeat-prompt-trim.ts`
+finds the block to trim by matching this exact line, so the two files must not hold two copies of it.
+*/
+export const TRIGGERING_COMMENT_HEADING = "New comments since last run:";
+
+/** Ids this agent was already shown for one card, newest advertisement first, capped. */
+export function collectAlreadyAdvertisedCommentIds(
+  runs: readonly AgentHeartbeatRun[],
+  taskId: string,
+): string[] {
+  const seen = new Set<string>();
+  const ordered: string[] = [];
+  for (const run of runs.slice(0, WAKE_COMMENT_CONSUMPTION_SCAN_RUNS)) {
+    if (run.taskId !== taskId && readSnapshotTaskId(run) !== taskId) continue;
+    const snapshot = run.contextSnapshot;
+    if (!snapshot || !Array.isArray(snapshot.triggeringCommentIds)) continue;
+    // The persisted array is chronological (it is a map over the card's own ordered comment list), so
+    // walking it backwards yields this run's newest advertisements first — which is what survives the
+    // cap below. `runs` itself already arrives newest-first from `getRecentRuns`.
+    for (const id of [...snapshot.triggeringCommentIds].reverse()) {
+      if (typeof id !== "string" || id.length === 0 || seen.has(id)) continue;
+      seen.add(id);
+      ordered.push(id);
+    }
+  }
+  return ordered.slice(0, MAX_CONSUMED_WAKE_COMMENT_IDS);
+}
+
+export interface WakeCommentDelta {
+  /** Ids to advertise on this wake. */
+  freshIds: string[];
+  /** Ids withheld because an earlier run of this agent already advertised them on this card. */
+  suppressedIds: string[];
+}
+
+/**
+ * Split a wake's candidate comment ids into what no earlier run of this agent has carried on this card
+ * and what one already advertised. An id that is not resolvable on the card is still consumed
+ * here — see `renderWakeCommentDelta` for why the unresolvable id is worth advertising once.
+ */
+export function consumeWakeCommentDelta(input: {
+  advertisedIds: readonly string[];
+  priorRuns: readonly AgentHeartbeatRun[];
+  taskId: string;
+}): WakeCommentDelta {
+  const alreadyAdvertised = new Set(collectAlreadyAdvertisedCommentIds(input.priorRuns, input.taskId));
+
+  const freshIds: string[] = [];
+  const suppressedIds: string[] = [];
+  for (const id of input.advertisedIds) {
+    (alreadyAdvertised.has(id) ? suppressedIds : freshIds).push(id);
+  }
+  return { freshIds, suppressedIds };
+}
+
+export interface RenderedWakeCommentDelta {
+  /** Prompt lines to splice into the wake delta. Empty when nothing was advertised. */
+  lines: string[];
+  /** Every id that received a line — the ids this wake has now consumed. */
+  advertisedIds: string[];
+  /** Advertised ids whose body is not on the card. */
+  missingIds: string[];
+  /** Ids withheld because their author is the agent being woken. Still consumed, never rendered. */
+  selfSuppressedIds: string[];
+}
+
+/**
+ * Render the wake delta's comment block: the body when the card holds it, and a loud line naming the
+ * id when it does not. The unresolvable branch is not a drop — the id is still returned in
+ * `advertisedIds`, so a second wake cannot re-advertise a body this wake was already told is
+ * unreachable. Trunk (RUFU-259) added that line precisely so a missing body could not be silent; an
+ * agent that has to conclude for itself that a body will never arrive is the same defect wearing a
+ * different label.
+ */
+export function renderWakeCommentDelta(input: {
+  taskId: string;
+  commentType: string;
+  ids: readonly string[];
+  lookup: ReadonlyMap<string, { author: string; text: string }>;
+  selfAuthorKeys: readonly string[];
+}): RenderedWakeCommentDelta {
+  if (input.ids.length === 0) {
+    return { lines: [], advertisedIds: [], missingIds: [], selfSuppressedIds: [] };
+  }
+
+  const formatCommentText = (text: string): string => text.replace(/\s+/g, " ").trim();
+  const bodyLines: string[] = [];
+  const missingIds: string[] = [];
+  const selfSuppressedIds: string[] = [];
+  const advertisedIds: string[] = [];
+
+  for (const commentId of input.ids) {
+    const comment = input.lookup.get(commentId);
+    if (comment && isSelfAuthoredComment(comment.author, input.selfAuthorKeys)) {
+      selfSuppressedIds.push(commentId);
+      continue;
+    }
+    if (comment) {
+      advertisedIds.push(commentId);
+      bodyLines.push(`- [${comment.author}] (commentId: ${commentId}): "${formatCommentText(comment.text)}"`);
+    } else {
+      advertisedIds.push(commentId);
+      missingIds.push(commentId);
+    }
+  }
+
+  if (selfSuppressedIds.length === input.ids.length) {
+    return { lines: [], advertisedIds: [], missingIds: [], selfSuppressedIds };
+  }
+
+  const lines = [
+    "",
+    "You were woken because of new comments on this task. Review them and take appropriate action.",
+    `Triggering comment type: ${input.commentType}`,
+    TRIGGERING_COMMENT_HEADING,
+    ...bodyLines,
+    ...missingIds.map((commentId) => `- [unknown] (commentId: ${commentId}): body is NOT on this card — do not guess its content`),
+    `Re-read any of these bodies with fn_task_show(id: "${input.taskId}", commentIds: [...]) — that tool returns comment bodies by id.`,
+  ];
+
+  return { lines, advertisedIds, missingIds, selfSuppressedIds };
+}
+
+/** The identities that count as this agent speaking to itself. */
+export function selfAuthorKeys(agent: { id: string; name?: string | null }): string[] {
+  return [agent.id, agent.name ?? ""].map(normalizeAuthor).filter((key) => key.length > 0);
+}
+
+/**
+ * True only when the author string positively names one of `keys`. A missing or unrecognised author
+ * is external input: see the module header for why the engine declines to guess at self-echo.
+ */
+export function isSelfAuthoredComment(author: string | undefined, keys: readonly string[]): boolean {
+  const normalized = normalizeAuthor(author);
+  if (!normalized) return false;
+  return keys.includes(normalized);
+}
+
+/** Drops the rows the agent authored itself and keeps everything else, in arrival order. */
+export function selectExternalSteeringComments<T extends { author?: string }>(
+  comments: readonly T[],
+  keys: readonly string[],
+): T[] {
+  if (keys.length === 0) return [...comments];
+  return comments.filter((comment) => !isSelfAuthoredComment(comment.author, keys));
+}
+
+/** Self-echo keys for the executor lane, whose only handle on identity is the card's assignee. */
+export function selfAuthorKeysForTask(task: { assignedAgentId?: string | null }): string[] {
+  return task.assignedAgentId ? [normalizeAuthor(task.assignedAgentId)] : [];
+}
+
+function readSnapshotTaskId(run: AgentHeartbeatRun): string | undefined {
+  const snapshot = run.contextSnapshot;
+  if (!snapshot || typeof snapshot.taskId !== "string") return undefined;
+  return snapshot.taskId;
+}
+
+function normalizeAuthor(author: string | undefined): string {
+  return (author ?? "").trim().toLowerCase();
+}
