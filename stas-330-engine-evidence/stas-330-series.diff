diff --git a/packages/engine/src/__tests__/wake-comment-delta-consumption.test.ts b/packages/engine/src/__tests__/wake-comment-delta-consumption.test.ts
new file mode 100644
index 0000000000..a18cba77f7
--- /dev/null
+++ b/packages/engine/src/__tests__/wake-comment-delta-consumption.test.ts
@@ -0,0 +1,245 @@
+/*
+FNXC:WakeCommentConsumption 2026-10-16 (STAS-330) — written against trunk and observed FAILING first.
+
+The comment half of the heartbeat wake delta is recomputed, never consumed. The ids it advertises come
+from `packages/engine/src/agent-heartbeat.ts` (`steeringComments.filter(createdAt > lastRun.startedAt)`
+at the assignment wake) and are re-derived on every later wake, so an id the agent was already shown
+comes back as "New comments since last run" forever. STAS-270 measured the consequence: ids
+`b3102332`, `46128b1a`, `69516485` and `75217182` were re-advertised across 15+ re-wakes in two hours,
+the agent could resolve none of them (`0 of 0 readable`), and every wake it spent on them re-raised
+the same unanswerable question.
+
+The three defects this harness pins:
+
+1. No consumption. An id that a previous run of this agent, on this task, already put in front of it
+   must never be advertised again — the record of the advertisement is the run row's own
+   `contextSnapshot.triggeringCommentIds`, written when the run opened, so a crashed run cannot
+   un-consume it.
+2. Self-echo. Content attributed to the waking agent itself is not external input, and must not be
+   presented as new content in the heartbeat delta, in the executor's `## Steering Comments` section,
+   or to the workflow-input / await-input reply detectors.
+3. Unresolvable ids. An id whose body is not on the card still counts as advertised — the loud
+   "body is NOT on this card" line is the point of advertising it — and it is consumed like any other.
+
+Every case below carries an id through a first wake and then a second wake, which is the only shape
+that distinguishes recomputation from consumption.
+*/
+import { describe, it, expect } from "vitest";
+import type { AgentHeartbeatRun } from "@fusion/core";
+import {
+  MAX_CONSUMED_WAKE_COMMENT_IDS,
+  WAKE_COMMENT_CONSUMPTION_SCAN_RUNS,
+  collectAlreadyAdvertisedCommentIds,
+  consumeWakeCommentDelta,
+  isSelfAuthoredComment,
+  renderWakeCommentDelta,
+  selectExternalSteeringComments,
+  selfAuthorKeys,
+} from "../agents/wake-comment-delta.js";
+
+function runAdvertising(taskId: string, ids: string[], startedAt = "2026-10-02T18:00:00.000Z"): AgentHeartbeatRun {
+  return {
+    id: `run-${ids.join("-") || "empty"}`,
+    agentId: "agent-ff03cfcc",
+    taskId,
+    startedAt,
+    endedAt: null,
+    status: "active",
+    contextSnapshot: { taskId, triggeringCommentIds: ids },
+  } as AgentHeartbeatRun;
+}
+
+describe("wake comment delta is consumed, not recomputed", () => {
+  it("advertises an id the agent has never been shown", () => {
+    const delta = consumeWakeCommentDelta({
+      advertisedIds: ["1759478901234-aaaaaa"],
+      priorRuns: [],
+      taskId: "STAS-270",
+    });
+
+    expect(delta.freshIds).toEqual(["1759478901234-aaaaaa"]);
+    expect(delta.suppressedIds).toEqual([]);
+  });
+
+  it("suppresses an id an earlier run already advertised on the same card (STAS-270 b3102332)", () => {
+    const prior = runAdvertising("STAS-270", ["b3102332", "46128b1a"]);
+
+    const delta = consumeWakeCommentDelta({
+      advertisedIds: ["b3102332", "46128b1a", "69516485"],
+      priorRuns: [prior],
+      taskId: "STAS-270",
+    });
+
+    expect(delta.freshIds).toEqual(["69516485"]);
+    expect(delta.suppressedIds).toEqual(["b3102332", "46128b1a"]);
+  });
+
+  it("re-advertises the same id for a different card — consumption is per (agent, task)", () => {
+    const delta = consumeWakeCommentDelta({
+      advertisedIds: ["b3102332"],
+      priorRuns: [runAdvertising("STAS-281", ["b3102332"])],
+      taskId: "STAS-270",
+    });
+
+    expect(delta.freshIds).toEqual(["b3102332"]);
+  });
+
